# Inputs and outputs outside git: fetched sources (ref/), every build directory (build/).
# Nothing derived from the player's disc is ever committed, except native/data/initial_pipeline_cache.db:
# pipeline keys (GX state) recorded from runs of the game, no game data (docs/SWITCH_BUILD.md).
ref/
/build*/
cmake-build-*/

# Disc images and extracted game data
*.iso
*.rvz
*.gcm
*.nfs
*.wbfs
*.wia
*.ciso
*.gcz
*.dol
*.rel

# Saves, captures, signing material
*.sav
*.gci
*.card
*.raw
*.profraw
*.profdata
dolphin_*.bin
*.keys
*.p12

# Build artifacts
*.o
*.a
*.dylib
*.nro
*.nsp
*.nacp
*.elf

# Tools and editors
__pycache__/
.DS_Store
.idea/
.vscode/
*.swp
*~
*.log

# Apple Vision Pro port (visionos/): build trees and caches, scratch work, generated Xcode projects
/.scratch/
/.wip/
visionos/App/*.xcodeproj/
# The game's files and anything derived from them never go in the repository: disc images (above),
# asset headers (build/), saves and caches the app writes into its Documents, dumps from test hooks
*.gcm
mirror-dump/
window-*.raw
# Trevorbilt's private terms for stage-release.sh (one extended regex a line), never committed
/.release-private-terms
