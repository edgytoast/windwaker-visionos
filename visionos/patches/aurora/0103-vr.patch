+void GXAuroraSetEyeTransform(const void* mtx) {
+  GX_WRITE_AURORA(GX_AURORA_SET_EYE_TRANSFORM);
+  GX_WRITE_U8(mtx != nullptr ? 1 : 0);
+  if (mtx != nullptr) {
+    const f32* values = reinterpret_cast<const f32*>(mtx);
+    for (int i = 0; i < 16; ++i) {
+      GX_WRITE_F32(values[i]);
+    }
+  }
+}
+
+void GXAuroraDepthSnapshotHere(f32 u0, f32 v0, f32 du, f32 dv) {
+  GX_WRITE_AURORA(GX_AURORA_DEPTH_SNAPSHOT_HERE);
+  GX_WRITE_F32(u0);
+  GX_WRITE_F32(v0);
+  GX_WRITE_F32(du);
+  GX_WRITE_F32(dv);
+}
+
+void GXAuroraSetOffscreenNativeLogical(GXBool enabled) {
+  GX_WRITE_AURORA(GX_AURORA_SET_OFFSCREEN_NATIVE_LOGICAL);
+  GX_WRITE_U8(enabled ? 1 : 0);
+}
+
 void GXAuroraMirrorMark(u32 mark, f32 value) {
   GX_WRITE_AURORA(GX_AURORA_MIRROR_MARK);
   GX_WRITE_U32(mark);
