+void mark_depth_snapshot(float u0, float v0, float du, float dv) {
+  if (!g_recorder.active() || g_recorder.currentRenderPass == UINT32_MAX) {
+    return;
+  }
+  auto& pass = current_render_passes()[g_recorder.currentRenderPass];
+  pass.captureDepthSnapshot = true;
+  pass.depthSnapshotMapped = true;
+  pass.depthSnapshotMap = {u0, v0, du, dv};
+  g_depthSnapshotMarked = true;
+}
