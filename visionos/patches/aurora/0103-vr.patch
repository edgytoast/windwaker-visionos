+#ifndef DOLPHIN_GXAURORASTEREO_H
+#define DOLPHIN_GXAURORASTEREO_H
+
+// Stereo rendering for VR hosts (Apple Vision Pro, visionos/patches/aurora/0103-vr.patch). A header
+// of its own, so the game's units, which include <dolphin/gx.h>, don't depend on it.
+
+#include <dolphin/types.h>
+#include <dolphin/gx/GXEnum.h>
+
+#if __cplusplus
+extern "C" {
+#endif
+
+/**
+ * A transform applied after the modelview to perspective draws, as clip = projection * eye *
+ * position. Followed by a u8 (0 clears it) and sixteen f32 in row-major order. Orthographic draws
+ * (2D, screen effects) are unaffected.
+ */
+#define GX_AURORA_SET_EYE_TRANSFORM 0x0070
+
+/**
+ * Offscreen passes (create_pass, GXCreateFrameBuffer) normally take their own size as the logical
+ * framebuffer size, so the game's viewport and scissor are taken in their pixels. Followed by a u8:
+ * 1 maps them from the game's configured framebuffer size instead, as on the EFB, so a pass of any
+ * size is drawn whole (VR eye images and panels); 0 restores the default.
+ */
+#define GX_AURORA_SET_OFFSCREEN_NATIVE_LOGICAL 0x0071
+
+/**
+ * The current pass (a VR eye's) is the frame's depth snapshot for GXPeekZ, in place of the EFB's last
+ * pass. Followed by four f32: u0, v0, du, dv, the snapshot's normalized point (x, y) read from the
+ * pass at (u0 + du * x, v0 + dv * y), so peeks made in another projection's screen coordinates
+ * land where that projection put them.
+ */
+#define GX_AURORA_DEPTH_SNAPSHOT_HERE 0x0072
+
+/** GX_AURORA_SET_EYE_TRANSFORM: `mtx` is a row-major 4x4; NULL clears it. In GX stream order. */
+void GXAuroraSetEyeTransform(const void* mtx);
+
+/** GX_AURORA_SET_OFFSCREEN_NATIVE_LOGICAL, in GX stream order. */
+void GXAuroraSetOffscreenNativeLogical(GXBool enabled);
+
+/** GX_AURORA_DEPTH_SNAPSHOT_HERE, in GX stream order. */
+void GXAuroraDepthSnapshotHere(f32 u0, f32 v0, f32 du, f32 dv);
+
+#if __cplusplus
+}
+#endif
+
+#endif
